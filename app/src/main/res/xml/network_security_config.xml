<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- HTTPS only, trusting the system certificate store and nothing the user installed. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
