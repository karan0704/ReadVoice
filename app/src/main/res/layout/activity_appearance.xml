<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_xs"
        android:paddingEnd="@dimen/space_m">

        <ImageButton
            android:id="@+id/backButton"
            style="@style/Widget.ReadVoice.IconButton"
            android:contentDescription="@string/action_back"
            android:src="@drawable/ic_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_s"
            android:layout_weight="1"
            android:text="@string/appearance_title"
            android:textSize="@dimen/text_title"
            android:textStyle="bold" />
    </LinearLayout>

    <View style="@style/Widget.ReadVoice.Divider" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/Widget.ReadVoice.SectionHeader"
                android:text="@string/appearance_theme" />

            <RadioGroup
                android:id="@+id/themeGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/radio_gutter"
                android:paddingEnd="@dimen/space_m">

                <RadioButton
                    android:id="@+id/themeBlack"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/touch_target"
                    android:text="@string/theme_black"
                    android:textSize="@dimen/text_body" />

                <RadioButton
                    android:id="@+id/themeWhite"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/touch_target"
                    android:text="@string/theme_white"
                    android:textSize="@dimen/text_body" />

                <RadioButton
                    android:id="@+id/themeFollowPhone"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/touch_target"
                    android:text="@string/theme_follow_phone"
                    android:textSize="@dimen/text_body" />
            </RadioGroup>

            <View style="@style/Widget.ReadVoice.Divider" />

            <TextView
                style="@style/Widget.ReadVoice.SectionHeader"
                android:text="@string/appearance_font" />

            <RadioGroup
                android:id="@+id/fontGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/radio_gutter"
                android:paddingEnd="@dimen/space_m">

                <RadioButton
                    android:id="@+id/fontSystem"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/touch_target"
                    android:text="@string/font_system"
                    android:textSize="@dimen/text_body" />

                <RadioButton
                    android:id="@+id/fontSerif"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/touch_target"
                    android:text="@string/font_serif"
                    android:textSize="@dimen/text_body" />

                <RadioButton
                    android:id="@+id/fontMonospace"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/touch_target"
                    android:text="@string/font_monospace"
                    android:textSize="@dimen/text_body" />

                <RadioButton
                    android:id="@+id/fontAtkinson"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/touch_target"
                    android:text="@string/font_atkinson"
                    android:textSize="@dimen/text_body" />
            </RadioGroup>

            <View style="@style/Widget.ReadVoice.Divider" />

            <TextView
                style="@style/Widget.ReadVoice.SectionHeader"
                android:text="@string/appearance_text_size" />

            <SeekBar
                android:id="@+id/textSizeBar"
                android:layout_width="match_parent"
                android:layout_height="@dimen/touch_target"
                android:paddingStart="@dimen/space_m"
                android:paddingEnd="@dimen/space_m"
                android:contentDescription="@string/appearance_text_size" />

            <View style="@style/Widget.ReadVoice.Divider" />

            <TextView
                style="@style/Widget.ReadVoice.SectionHeader"
                android:text="@string/appearance_preview" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/space_m"
                android:paddingEnd="@dimen/space_m"
                android:paddingBottom="@dimen/space_l">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/preview_author"
                        android:textSize="@dimen/text_body"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/preview_time"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_label" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:text="@string/preview_label"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_label" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:text="@string/preview_body"
                    android:textSize="@dimen/text_body" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
