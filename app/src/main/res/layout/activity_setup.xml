<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_xs"
        android:paddingEnd="@dimen/space_m">

        <ImageButton
            android:id="@+id/backButton"
            style="@style/Widget.ReadVoice.IconButton"
            android:contentDescription="@string/action_back"
            android:src="@drawable/ic_back" />

        <!-- 12dp keeps the title on the 16dp gutter when the back button is hidden. -->
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_title_inset"
            android:layout_weight="1"
            android:text="@string/setup_title"
            android:textSize="@dimen/text_title"
            android:textStyle="bold" />
    </LinearLayout>

    <View style="@style/Widget.ReadVoice.Divider" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_m">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/setup_intro"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_body" />

            <TextView
                style="@style/Widget.ReadVoice.Step"
                android:text="@string/setup_step_open" />

            <Button
                android:id="@+id/openRedditButton"
                style="@style/Widget.ReadVoice.Button.Outline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:text="@string/setup_open_reddit" />

            <TextView
                style="@style/Widget.ReadVoice.Step"
                android:text="@string/setup_step_create" />

            <TextView
                style="@style/Widget.ReadVoice.Step"
                android:text="@string/setup_step_name" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/setup_app_name_value"
                    android:textIsSelectable="true"
                    android:textSize="@dimen/text_body"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/copyNameButton"
                    style="@style/Widget.ReadVoice.Button.Outline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_s"
                    android:text="@string/setup_copy" />
            </LinearLayout>

            <TextView
                style="@style/Widget.ReadVoice.Step"
                android:text="@string/setup_step_redirect" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/redirectValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textIsSelectable="true"
                    android:textSize="@dimen/text_body"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/copyRedirectButton"
                    style="@style/Widget.ReadVoice.Button.Outline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_s"
                    android:text="@string/setup_copy" />
            </LinearLayout>

            <TextView
                style="@style/Widget.ReadVoice.Step"
                android:text="@string/setup_step_copy_id" />

            <TextView
                style="@style/Widget.ReadVoice.Step"
                android:text="@string/setup_step_paste" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/clientIdInput"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/setup_client_id_hint"
                    android:importantForAutofill="no"
                    android:inputType="textVisiblePassword|textNoSuggestions"
                    android:maxLength="64"
                    android:maxLines="1"
                    android:minHeight="@dimen/touch_target"
                    android:textColorHint="@color/text_secondary"
                    android:textSize="@dimen/text_body" />

                <Button
                    android:id="@+id/pasteButton"
                    style="@style/Widget.ReadVoice.Button.Outline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_s"
                    android:text="@string/setup_paste" />
            </LinearLayout>

            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_label" />

            <Button
                android:id="@+id/checkButton"
                style="@style/Widget.ReadVoice.Button.Outline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:text="@string/setup_check" />

            <Button
                android:id="@+id/saveButton"
                style="@style/Widget.ReadVoice.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:text="@string/setup_save" />

            <Button
                android:id="@+id/removeButton"
                style="@style/Widget.ReadVoice.Button.Outline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:text="@string/setup_remove"
                android:visibility="gone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:text="@string/setup_note"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_label" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
